{
  "type": "layout",
  "id": "docs",
  "fields": {
    "header": { "type": "panel" },
    "sidebar": { "type": "panel" },
    "content": { "type": "children" }
  },
  "grid": {
    "desktop": {
      "rows": [
        {
          "gap": 0,
          "sticky": true,
          "top": 0,
          "height": 64,
          "background": "var(--background)",
          "border": { "bottom": "1px solid var(--border)" },
          "columns": [{ "field": "header", "valign": "middle" }]
        },
        {
          "gap": 0,
          "maxWidth": 1440,
          "margin": "0 auto",
          "columns": [
            {
              "field": "sidebar",
              "width": "272px",
              "sticky": true,
              "top": 64,
              "height": "calc(100vh - 64px)",
              "scroll": true,
              "background": "var(--muted)",
              "padding": "32px 32px 96px",
              "border": { "right": "1px solid var(--border)" }
            },
            { "field": "content", "padding": "32px 24px 96px" }
          ]
        }
      ]
    },
    "mobile": {
      "rows": [
        {
          "gap": 0,
          "sticky": true,
          "top": 0,
          "height": 56,
          "background": "var(--background)",
          "border": { "bottom": "1px solid var(--border)" },
          "columns": [{ "field": "header", "valign": "middle" }]
        },
        { "gap": 0, "columns": [{ "field": "content", "padding": "24px 24px 48px" }] },
        {
          "gap": 0,
          "columns": [
            {
              "field": "sidebar",
              "padding": "24px",
              "background": "var(--muted)",
              "border": { "top": "1px solid var(--border)" }
            }
          ]
        }
      ]
    }
  }
}
