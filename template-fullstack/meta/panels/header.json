{
  "type": "panel",
  "id": "header",
  "fields": {
    "logo": {
      "type": "image",
      "props": {
        "src": "/logo.svg",
        "alt": "",
        "width": 24,
        "height": 24
      }
    },
    "brand": {
      "type": "text",
      "props": {
        "children": "Blueprint",
        "variant": "subheading"
      }
    },
    "search": {
      "type": "search",
      "props": {
        "placeholder": "Search"
      }
    },
    "menu": {
      "type": "nav",
      "props": {
        "orientation": "horizontal",
        "variant": "plain",
        "sections": true
      }
    },
    "theme": {
      "type": "theme"
    },
    "github": {
      "type": "icon",
      "props": {
        "name": "git-branch",
        "size": 20,
        "label": "GitHub",
        "href": "https://github.com/OWNER/REPO"
      }
    }
  },
  "grid": {
    "desktop": {
      "rows": [
        {
          "valign": "middle",
          "maxWidth": 1440,
          "margin": "0 auto",
          "padding": "0 32px",
          "gap": 12,
          "columns": [
            {
              "field": "logo",
              "width": "auto"
            },
            {
              "field": "brand",
              "width": "auto"
            },
            {
              "field": "search",
              "width": "220px",
              "margin": "0 0 0 32px"
            },
            {
              "field": "menu",
              "align": "right"
            },
            {
              "field": "theme",
              "width": "auto",
              "margin": "0 0 0 16px"
            },
            {
              "field": "github",
              "width": "auto"
            }
          ]
        }
      ]
    },
    "mobile": {
      "rows": [
        {
          "valign": "middle",
          "padding": "0 16px",
          "gap": 8,
          "columns": [
            {
              "field": "logo",
              "width": "auto"
            },
            {
              "field": "brand"
            },
            {
              "field": "theme",
              "width": "auto"
            },
            {
              "field": "github",
              "width": "auto"
            }
          ]
        }
      ]
    }
  }
}
