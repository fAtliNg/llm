{
  "type": "panel",
  "id": "header",
  "fields": {
    "brand": {
      "type": "panel"
    },
    "search": {
      "type": "search",
      "props": {
        "placeholder": "Search"
      }
    },
    "menu": {
      "type": "nav",
      "props": {
        "orientation": "horizontal",
        "variant": "plain",
        "sections": true
      }
    },
    "theme": {
      "type": "theme"
    },
    "github": {
      "type": "icon",
      "props": {
        "name": "github",
        "size": 20,
        "label": "GitHub",
        "href": "https://github.com/OWNER/REPO"
      }
    }
  },
  "grid": {
    "desktop": {
      "rows": [
        {
          "valign": "middle",
          "maxWidth": 1440,
          "margin": "0 auto",
          "gap": 0,
          "columns": [
            {
              "field": "brand",
              "width": "272px",
              "padding": "0 32px",
              "height": 63,
              "border": {
                "bottom": "1px solid $border"
              },
              "valign": "middle"
            },
            {
              "field": "search",
              "width": "auto",
              "margin": "0 0 0 32px"
            },
            {
              "field": "menu",
              "align": "right",
              "margin": "0 24px 0 0"
            },
            {
              "field": "theme",
              "width": "auto",
              "padding": "0 24px",
              "border": {
                "left": "1px solid $border",
                "right": "1px solid $border"
              },
              "height": 24,
              "valign": "middle"
            },
            {
              "field": "github",
              "width": "auto",
              "padding": "0 32px 0 24px"
            }
          ]
        }
      ]
    },
    "mobile": {
      "rows": [
        {
          "valign": "middle",
          "padding": "0 16px",
          "gap": 12,
          "columns": [
            {
              "field": "brand"
            },
            {
              "field": "theme",
              "width": "auto"
            },
            {
              "field": "github",
              "width": "auto"
            }
          ]
        }
      ]
    }
  }
}
