{
  "type": "panel",
  "id": "overview-article",
  "fields": {
    "h1": {
      "type": "text",
      "props": {
        "children": "Overview",
        "variant": "title"
      }
    },
    "p1": {
      "type": "text",
      "props": {
        "children": "Base app, entity descriptions, generated code, hooks and the model: how the parts fit."
      }
    },
    "info": {
      "type": "alert",
      "props": {
        "children": "Draft."
      }
    },
    "pager": {
      "type": "pager"
    },
    "edit-icon": {
      "type": "icon",
      "props": {
        "name": "square-pen",
        "size": 14
      }
    },
    "edit": {
      "type": "text",
      "props": {
        "children": "Edit this page",
        "variant": "link",
        "href": "https://github.com/OWNER/REPO"
      }
    },
    "updated": {
      "type": "text",
      "props": {
        "children": "Last updated: 21.09.2026, 12:51",
        "variant": "muted"
      }
    }
  },
  "grid": {
    "desktop": {
      "rows": [
        {
          "gap": 0,
          "columns": [
            {
              "field": "h1"
            }
          ],
          "margin": "0 0 16px"
        },
        {
          "gap": 0,
          "columns": [
            {
              "field": "p1"
            }
          ],
          "margin": "0 0 16px"
        },
        {
          "gap": 0,
          "columns": [
            {
              "field": "info"
            }
          ],
          "margin": "0"
        },
        {
          "gap": 6,
          "valign": "middle",
          "margin": "48px 0 0",
          "padding": "24px 0 0",
          "border": {
            "top": "1px solid $border"
          },
          "columns": [
            {
              "field": "edit-icon",
              "width": "auto"
            },
            {
              "field": "edit",
              "width": "auto"
            },
            {
              "field": "updated",
              "align": "right"
            }
          ]
        },
        {
          "gap": 0,
          "columns": [
            {
              "field": "pager"
            }
          ],
          "margin": "24px 0 0"
        }
      ]
    }
  }
}
