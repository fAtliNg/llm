{
  "type": "page",
  "id": "objects",
  "name": "Objects",
  "layout": "docs",
  "fields": {
    "intro": {
      "type": "text",
      "props": {
        "children": "Five kinds of object, told apart by type. Containers declare their fields once and place them on a grid per screen size; a field is one component with its props."
      }
    },
    "page-h": { "type": "text", "props": { "children": "page", "variant": "heading" } },
    "page-t": {
      "type": "text",
      "props": {
        "children": "A route with a heading. name gives the URL; layout names the frame it is shown in."
      }
    },
    "layout-h": { "type": "text", "props": { "children": "layout", "variant": "heading" } },
    "layout-t": {
      "type": "text",
      "props": {
        "children": "A frame around pages: header, menu, footer and one field of type children where the page goes. Layouts nest."
      }
    },
    "field-h": { "type": "text", "props": { "children": "field", "variant": "heading" } },
    "field-t": {
      "type": "text",
      "props": {
        "children": "The atom: type is a component folder in src/components/ui, props are that component's props. Built-ins: children, nav, text."
      }
    },
    "soon": {
      "type": "badge",
      "props": { "variant": "outline", "children": "table, form and panel: coming next" }
    }
  },
  "grid": {
    "desktop": {
      "rows": [
        { "columns": [{ "field": "intro" }] },
        { "columns": [{ "field": "page-h" }, { "field": "layout-h" }, { "field": "field-h" }] },
        {
          "valign": "top",
          "columns": [{ "field": "page-t" }, { "field": "layout-t" }, { "field": "field-t" }]
        },
        { "align": "left", "columns": [{ "field": "soon" }] }
      ]
    },
    "mobile": {
      "rows": [
        { "columns": [{ "field": "intro" }] },
        { "columns": [{ "field": "page-h" }] },
        { "columns": [{ "field": "page-t" }] },
        { "columns": [{ "field": "layout-h" }] },
        { "columns": [{ "field": "layout-t" }] },
        { "columns": [{ "field": "field-h" }] },
        { "columns": [{ "field": "field-t" }] },
        { "align": "left", "columns": [{ "field": "soon" }] }
      ]
    }
  }
}
