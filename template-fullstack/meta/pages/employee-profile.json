{
  "type": "page",
  "id": "employee-profile",
  "name": "Employee profile",
  "fields": {
    "first-name": {
      "type": "input",
      "props": {
        "placeholder": "First name",
        "aria-label": "First name"
      }
    },
    "last-name": {
      "type": "input",
      "props": {
        "placeholder": "Last name",
        "aria-label": "Last name"
      }
    },
    "email": {
      "type": "input",
      "props": {
        "type": "email",
        "placeholder": "name@company.com",
        "aria-label": "Email"
      }
    },
    "phone": {
      "type": "input",
      "props": {
        "type": "tel",
        "placeholder": "+1 555 0100",
        "aria-label": "Phone"
      }
    },
    "start-date": {
      "type": "input",
      "props": {
        "type": "date",
        "aria-label": "Start date"
      }
    },
    "salary": {
      "type": "input",
      "props": {
        "type": "number",
        "placeholder": "Salary",
        "aria-label": "Salary",
        "min": 0,
        "step": 100
      }
    },
    "bio": {
      "type": "textarea",
      "props": {
        "placeholder": "A few words about the employee",
        "aria-label": "Bio",
        "rows": 4
      }
    },
    "remote": {
      "type": "switch",
      "props": {
        "aria-label": "Works remotely"
      }
    },
    "newsletter": {
      "type": "checkbox",
      "props": {
        "aria-label": "Subscribe to the newsletter"
      }
    },
    "status": {
      "type": "badge",
      "props": {
        "variant": "secondary",
        "children": "Active"
      }
    },
    "level": {
      "type": "slider",
      "props": {
        "defaultValue": [3],
        "min": 1,
        "max": 5,
        "step": 1,
        "aria-label": "Seniority level"
      }
    },
    "onboarding": {
      "type": "progress",
      "props": {
        "value": 60,
        "aria-label": "Onboarding progress"
      }
    },
    "note": {
      "type": "alert",
      "props": {
        "children": "Changes are saved when you press Save; nothing is stored while you type."
      }
    },
    "divider": {
      "type": "separator",
      "props": {}
    },
    "save": {
      "type": "button",
      "props": {
        "children": "Save"
      }
    },
    "cancel": {
      "type": "button",
      "props": {
        "variant": "outline",
        "children": "Cancel"
      }
    },
    "delete": {
      "type": "button",
      "props": {
        "variant": "destructive",
        "children": "Delete employee"
      }
    }
  },
  "layout": {
    "desktop": {
      "rows": [
        {
          "columns": [
            {
              "field": "note"
            }
          ]
        },
        {
          "valign": "middle",
          "columns": [
            {
              "field": "first-name"
            },
            {
              "field": "last-name"
            },
            {
              "field": "status",
              "align": "left"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "email"
            },
            {
              "field": "phone"
            }
          ]
        },
        {
          "valign": "middle",
          "columns": [
            {
              "field": "start-date"
            },
            {
              "field": "salary"
            },
            {
              "field": "remote",
              "align": "center"
            },
            {
              "field": "newsletter",
              "align": "center"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "bio"
            }
          ]
        },
        {
          "valign": "middle",
          "padding": "8px 0",
          "columns": [
            {
              "field": "level"
            },
            {
              "field": "onboarding"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "divider"
            }
          ]
        },
        {
          "align": "right",
          "margin": "16px 0 0",
          "columns": [
            {
              "field": "save",
              "align": "left"
            },
            {
              "field": "cancel"
            },
            {
              "field": "delete"
            }
          ]
        }
      ]
    },
    "mobile": {
      "rows": [
        {
          "columns": [
            {
              "field": "status"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "first-name"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "last-name"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "email"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "phone"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "start-date"
            },
            {
              "field": "salary"
            }
          ]
        },
        {
          "valign": "middle",
          "columns": [
            {
              "field": "remote",
              "align": "left"
            },
            {
              "field": "newsletter",
              "align": "left"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "bio"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "level"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "onboarding"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "divider"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "save"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "cancel"
            }
          ]
        },
        {
          "columns": [
            {
              "field": "delete"
            }
          ]
        }
      ]
    }
  }
}
