{
  "type": "page",
  "id": "settings",
  "name": "Settings",
  "fields": {
    "company": {
      "type": "input",
      "props": { "placeholder": "Company name", "aria-label": "Company name" }
    },
    "notifications": { "type": "switch", "props": { "aria-label": "Email notifications" } },
    "save": { "type": "button", "props": { "children": "Save settings" } }
  },
  "layout": {
    "desktop": {
      "rows": [
        { "columns": [{ "field": "company" }, { "field": "notifications" }, { "field": "save" }] }
      ]
    },
    "tablet": {
      "rows": [
        { "columns": [{ "field": "company" }, { "field": "notifications" }] },
        { "columns": [{ "field": "save" }] }
      ]
    },
    "mobile": {
      "rows": [
        { "columns": [{ "field": "company" }] },
        { "columns": [{ "field": "notifications" }] },
        { "columns": [{ "field": "save" }] }
      ]
    }
  }
}
