# Ollama model definition for the fine-tuned student. Same renderer/parser as the base qwen3.5,
# so the prompt format matches what the model was trained on. Build:
#   ollama create qwen3.5-9b-agent:v1-q4 -f Modelfile   (after putting the GGUF path below)
FROM ./gguf-q4_k_m/model.gguf
RENDERER qwen3.5
PARSER qwen3.5
PARAMETER num_ctx 32768
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER presence_penalty 1.0
# llama.cpp spins one busy thread per core while the GPU works; cap it so verify/tests keep CPU.
PARAMETER num_thread 4
