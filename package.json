{
  "name": "lvc",
  "version": "0.0.0",
  "description": "Local Vibe Coding \u2014 an offline, private coding agent driven by small specialized code models",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "lvc": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"{src,tests,docs}/**/*.{ts,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "local-first",
    "offline",
    "codegen",
    "ollama",
    "llama.cpp",
    "qwen"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.3",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.2",
    "ignore": "^7.0.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
